# --- Frontend (Vite) : safe to expose, these are public by design ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Base URL used to build QR links: https://<this>/track/<token>
VITE_PUBLIC_APP_URL=https://your-domain.com

# --- Edge Function secrets (set with `supabase secrets set`, NEVER in frontend code) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
ALLOWED_ORIGINS=https://your-domain.com
IP_HASH_SECRET=generate-with-openssl-rand-hex-32
