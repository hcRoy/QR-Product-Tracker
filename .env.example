# --- Frontend (Vite) : safe to expose, these are public by design ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Base URL used to build QR links: https://<this>/track/<token>
VITE_PUBLIC_APP_URL=https://your-domain.com
# Optional MapLibre style URL for the admin map. Default: OpenFreeMap (free, no key).
# Other OpenFreeMap styles: .../styles/liberty, .../styles/bright
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Edge Function secrets (set with `supabase secrets set`, NEVER in frontend code) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
ALLOWED_ORIGINS=https://your-domain.com
IP_HASH_SECRET=generate-with-openssl-rand-hex-32
# Reverse geocoding (area/city/state/country) in track-scan.
# Recommended: free LocationIQ token (https://locationiq.com, 5,000 requests/day on the free plan).
# Without it, public Nominatim is used, which may throttle or block requests from cloud servers.
LOCATIONIQ_API_KEY=
# Contact email sent to Nominatim, as its usage policy requires.
GEOCODE_CONTACT_EMAIL=you@your-domain.com
